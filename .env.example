# Fichier de configuration — copiez ce fichier en .env et renseignez vos valeurs

# Clé API Anthropic (obligatoire)
# Obtenir sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI

# Modèle Claude utilisé (optionnel — ne pas modifier sauf besoin)
CLAUDE_MODEL=claude-sonnet-4-6

# Supabase — persistance cloud (optionnel)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=sb_secret_XXXX

# Notifications email SMTP (optionnel)
# Utiliser un mot de passe d'application Gmail (pas le vrai mot de passe)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=Qual.IA <votre.email@gmail.com>
EMAIL_ADMIN=admin@votre-entreprise.com
