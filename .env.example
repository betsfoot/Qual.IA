# Fichier de configuration — copiez ce fichier en .env et renseignez vos valeurs

# Clé API Anthropic (obligatoire)
# Obtenir sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI

# Modèle Claude utilisé (optionnel — ne pas modifier sauf besoin)
CLAUDE_MODEL=claude-sonnet-4-6

# Supabase — persistance cloud (optionnel)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=sb_secret_XXXX

# Notifications email via Resend (optionnel)
# Créer un compte gratuit sur https://resend.com (3 000 emails/mois offerts)
# 1. Créer une clé API dans le dashboard Resend
# 2. Vérifier votre domaine d'expéditeur (ou utiliser onboarding@resend.dev pour les tests)
RESEND_API_KEY=re_VOTRE_CLE_ICI
RESEND_FROM=Qual.IA <notifications@votre-domaine.com>
